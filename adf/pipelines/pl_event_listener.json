{
  "name": "pl_event_listener",
  "properties": {
    "description": "Orchestrator pipeline uruchamiany przez Storage Event Trigger. Wyciąga table_name z nazwy pliku, delegate do pl_validate_and_move, potem pl_incremental_load tylko dla tej tabeli.",
    "parameters": {
      "file_path": {
        "type": "string",
        "defaultValue": ""
      },
      "file_name": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "variables": {
      "table_name": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "SetVariableTableName",
        "description": "Wyciągnij nazwę tabeli z nazwy pliku (shipments_20240115.csv → shipments)",
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "table_name",
          "value": {
            "value": "@split(pipeline().parameters.file_name, '_')[0]",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ExecuteValidateAndMove",
        "description": "Walidacja pliku i kopia landing → bronze",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_validate_and_move",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "file_path": {
              "value": "@pipeline().parameters.file_path",
              "type": "Expression"
            },
            "file_name": {
              "value": "@pipeline().parameters.file_name",
              "type": "Expression"
            },
            "table_name": {
              "value": "@variables('table_name')",
              "type": "Expression"
            }
          }
        },
        "dependsOn": [
          {
            "activity": "SetVariableTableName",
            "dependencyConditions": ["Succeeded"]
          }
        ]
      },
      {
        "name": "ExecuteIncrementalLoad",
        "description": "Przyrostowe ładowanie bronze → silver z watermarkiem (tylko dla aktualnej tabeli)",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_incremental_load",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "tables": {
              "value": "@createArray(variables('table_name'))",
              "type": "Expression"
            }
          }
        },
        "dependsOn": [
          {
            "activity": "ExecuteValidateAndMove",
            "dependencyConditions": ["Succeeded"]
          }
        ]
      }
    ]
  }
}
